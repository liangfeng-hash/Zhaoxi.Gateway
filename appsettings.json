{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Debug"
      }
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/api/{**catch-all}" }
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "login", //登录限流
        "Match": { "Path": "/auth/{**catch-all}" }
      }
    },
    "Clusters": { //集群
      "api-cluster": {

        "LoadBalancingPolicy": "RoundRobin", // ← 加在这里


        //健康检查
        "HealthCheck": { // ← 加在这里
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },

        "Metadata": { // ← 和 HealthCheck 平级
          "ConsecutiveFailuresHealthPolicy.Threshold": "3"
        },

        "Destinations": {
          "d1": { "Address": "http://localhost:8000/" },
          "d2": { "Address": "http://172.16.0.15:8000/" }

        }
      },

      "auth-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:8001/" }
        }
      }
    }
  },
  "HttpsRedirection": { "HttpsPort": 443 }
}